<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Killora Bot Control Center · <%= guild.name %></title><link rel="stylesheet" href="/style.css"><style>
.premium-shell{max-width:1180px;margin:28px auto;padding:0 18px}.premium-head{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.premium-head h1{margin:5px 0}.premium-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin:18px 0}.premium-card{background:var(--card,#111827);border:1px solid var(--border,#263244);border-radius:16px;padding:18px;min-width:0}.premium-card h2{margin:0 0 8px;font-size:19px}.premium-card p,.muted{color:var(--muted,#94a3b8)}.stat{font-size:30px;font-weight:800}.premium-nav{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.premium-nav a{padding:9px 12px;border:1px solid var(--border,#263244);border-radius:10px;text-decoration:none}.premium-card label{display:block;margin:12px 0}.premium-card input:not([type=checkbox]),.premium-card textarea,.premium-card select{width:100%;box-sizing:border-box;margin-top:6px}.premium-card textarea{min-height:90px}.premium-row{display:flex;gap:12px;flex-wrap:wrap}.premium-row>*{flex:1}.premium-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.premium-status{font-size:13px;margin-top:10px;min-height:18px}.premium-preview{border-left:4px solid #39ff14;background:#0b1220;padding:12px;border-radius:8px;white-space:pre-wrap}.premium-list{display:grid;gap:8px;margin-top:12px}.premium-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px;border:1px solid var(--border,#263244);border-radius:10px}.premium-item small{display:block;color:var(--muted,#94a3b8)}.pill{font-size:12px;padding:4px 8px;border-radius:99px;background:#153b2a;color:#8df0b0}@media(max-width:600px){.premium-shell{padding:0 12px}.premium-card{padding:14px}}
</style></head><body><nav><b>KILLORA<span>_BOT</span></b><div><a href="/dashboard/<%=guild.id%>">← Server settings</a>　<a href="/dashboard">Servers</a>　<a href="/logout">Logout</a></div></nav>
<main class="premium-shell"><div class="premium-head"><div><div class="tag">KILLORA BOT CONTROL CENTER</div><h1><%=guild.name%></h1><p class="muted">Manage protection, automation and community tools from one place.</p></div><span class="pill">PREMIUM v1.3</span></div>
<div class="premium-grid" id="stats"><section class="premium-card"><p>Members</p><div class="stat" id="statMembers">—</div></section><section class="premium-card"><p>Channels</p><div class="stat" id="statChannels">—</div></section><section class="premium-card"><p>Bot latency</p><div class="stat" id="statPing">—</div></section><section class="premium-card"><p>Custom commands</p><div class="stat" id="statCommands">—</div></section></div>
<div class="premium-nav"><a href="#raid">Anti-Raid</a><a href="#backup">Backup</a><a href="#tickets">Tickets</a><a href="#embed">Embed Builder</a><a href="#modules">Leveling / Economy / Music</a><a href="#commands">Custom Commands</a></div>
<div class="premium-grid">
<section class="premium-card" id="raid"><h2>🛡️ Anti-Raid Protection</h2><p>Detect rapid member joins and activate a temporary server lockdown.</p><label><input type="checkbox" id="raidEnabled"> Enable anti-raid</label><div class="premium-row"><label>Join threshold<input type="number" id="raidThreshold" min="3" max="30" value="8"></label><label>Window (seconds)<input type="number" id="raidWindow" min="5" max="60" value="10"></label></div><label>Lockdown duration (minutes)<input type="number" id="raidLockdown" min="1" max="30" value="5"></label><label>Log channel ID<input id="raidLog" placeholder="Optional channel ID"></label><button class="btn" id="saveRaid">Save protection</button><div class="premium-status" id="raidStatus"></div></section>
<section class="premium-card" id="backup"><h2>💾 Backup & Restore</h2><p>Download a JSON backup of Killora's saved configuration for this server. Restore only a trusted backup.</p><div class="premium-actions"><button class="btn" id="downloadBackup">Download backup</button><label class="btn secondary" style="display:inline-block">Choose backup JSON<input type="file" id="restoreFile" accept="application/json,.json" hidden></label><button class="btn danger" id="restoreBackup">Restore selected backup</button></div><div class="premium-status" id="backupStatus"></div></section>
<section class="premium-card" id="tickets"><h2>🎫 Advanced Ticket System</h2><p>Ticket panel editor, categories, buttons, transcripts and staff controls.</p><div class="premium-actions"><a class="btn" href="/dashboard/<%=guild.id%>#tickets">Open ticket panel builder</a><a class="btn secondary" href="/dashboard/<%=guild.id%>#saved-panels">Saved panels & transcripts</a></div></section>
<section class="premium-card" id="embed"><h2>🎨 Custom Embed Builder</h2><label>Target channel<select id="embedChannel"><option value="">Loading channels…</option></select></label><label>Message content<input id="embedContent" maxlength="2000" placeholder="Optional message above embed"></label><label>Embed title<input id="embedTitle" maxlength="256" placeholder="Announcement"></label><label>Description<textarea id="embedDescription" maxlength="4000" placeholder="Write your embed message..."></textarea></label><div class="premium-row"><label>Color<input type="color" id="embedColor" value="#39ff14"></label><label>Footer<input id="embedFooter" maxlength="2048" placeholder="Killora Bot"></label></div><label>Thumbnail URL<input id="embedThumbnail" type="url" placeholder="https://..."></label><label>Image URL<input id="embedImage" type="url" placeholder="https://..."></label><div class="premium-preview" id="embedPreview"><b id="previewTitle">Embed title preview</b><p id="previewDescription">Your description will appear here.</p></div><div class="premium-actions"><button class="btn secondary" id="previewButton">Preview</button><button class="btn" id="sendEmbed">Send to Discord</button></div><div class="premium-status" id="embedStatus"></div></section>
<section class="premium-card" id="modules"><h2>🎮 Community Modules</h2><p>Enable leveling, economy and tune the existing music player.</p><label><input type="checkbox" id="levelEnabled"> Enable leveling</label><label><input type="checkbox" id="economyEnabled"> Enable economy</label><hr><label><input type="checkbox" id="musicEnabled"> Enable music</label><label><input type="checkbox" id="musicAlwaysOn"> Always-on voice mode</label><div class="premium-row"><label>Default volume<input type="number" id="musicVolume" min="0" max="100" value="80"></label><label>Queue limit<input type="number" id="musicQueue" min="1" max="500" value="100"></label></div><label>DJ role ID<input id="musicDjRole" placeholder="Optional role ID"></label><button class="btn" id="saveModules">Save module settings</button><div class="premium-status" id="moduleStatus"></div><p class="muted">These switches save module configuration. Actual command/event availability depends on the bot's installed handlers and Discord permissions.</p></section>
<section class="premium-card" id="commands"><h2>⌨️ Custom Commands</h2><p>Create text commands that the bot can answer in your server.</p><div class="premium-row"><label>Command name<input id="commandName" maxlength="32" placeholder="rules"></label><label>Cooldown seconds<input id="commandCooldown" type="number" min="0" max="3600" value="3"></label></div><label>Response<textarea id="commandResponse" maxlength="1900" placeholder="Please read #rules..."></textarea></label><label><input type="checkbox" id="commandEnabled" checked> Enabled</label><button class="btn" id="createCommand">Create command</button><div class="premium-status" id="commandStatus"></div><div class="premium-list" id="commandList">Loading commands…</div></section>
</div></main><script>
const gid=<%- JSON.stringify(guild.id) %>,api='/api/guild/'+gid+'/premium';const $=id=>document.getElementById(id);async function request(url,opts={}){const r=await fetch(url,{...opts,headers:{'Content-Type':'application/json',...(opts.headers||{})}});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||('HTTP '+r.status));return d}function status(id,msg,bad=false){$(id).textContent=msg;$(id).style.color=bad?'#ff8585':'#8df0b0'}
async function load(){try{const d=await request(api+'/overview');$('statMembers').textContent=d.members??'—';$('statChannels').textContent=d.channels??'—';$('statPing').textContent=d.bot?.ping==null?'—':d.bot.ping+' ms';$('statCommands').textContent=d.customCommands??0;const m=await request(api+'/modules');$('levelEnabled').checked=m.leveling.enabled;$('economyEnabled').checked=m.economy.enabled;$('musicEnabled').checked=m.music.enabled;$('musicAlwaysOn').checked=m.music.alwaysOn;$('musicVolume').value=m.music.defaultVolume;$('musicQueue').value=m.music.queueLimit;$('musicDjRole').value=m.music.djRoleId||'';const a=await request(api+'/anti-raid');$('raidEnabled').checked=!!a.enabled;$('raidThreshold').value=a.threshold??8;$('raidWindow').value=Math.round((a.windowMs??10000)/1000);$('raidLockdown').value=a.lockdownMinutes??5;$('raidLog').value=a.logChannelId||'';}catch(e){console.warn(e)}loadCommands();loadChannels()}
async function loadChannels(){try{const d=await request('/api/guild/'+gid+'/resources');$('embedChannel').innerHTML='<option value="">Select channel</option>'+d.channels.filter(c=>c.type===0||c.type===5).map(c=>`<option value="${c.id}">#${String(c.name).replace(/[<>&\"']/g,'')}</option>`).join('')}catch(e){$('embedChannel').innerHTML='<option value="">Unable to load channels</option>'}}
$('saveRaid').onclick=async()=>{try{await request(api+'/anti-raid',{method:'PUT',body:JSON.stringify({enabled:$('raidEnabled').checked,threshold:+$('raidThreshold').value,windowMs:+$('raidWindow').value*1000,lockdownMinutes:+$('raidLockdown').value,logChannelId:$('raidLog').value})});status('raidStatus','Anti-raid settings saved.')}catch(e){status('raidStatus',e.message,true)}};
$('downloadBackup').onclick=()=>{location.href='/api/guild/'+gid+'/backup';status('backupStatus','Backup download started.')};$('restoreBackup').onclick=async()=>{try{const f=$('restoreFile').files[0];if(!f)throw Error('Choose a backup JSON file first.');if(!confirm('Restore this backup? Current matching settings may be overwritten.'))return;const d=JSON.parse(await f.text());await request('/api/guild/'+gid+'/backup/restore',{method:'POST',body:JSON.stringify(d)});status('backupStatus','Backup restored. Refresh the page to see updated settings.')}catch(e){status('backupStatus',e.message,true)}};
function preview(){const color=$('embedColor').value;$('embedPreview').style.borderLeftColor=color;$('previewTitle').textContent=$('embedTitle').value||'Embed title preview';$('previewDescription').textContent=$('embedDescription').value||'Your description will appear here.'}['embedTitle','embedDescription','embedColor'].forEach(id=>$(id).addEventListener('input',preview));$('previewButton').onclick=preview;$('sendEmbed').onclick=async()=>{try{await request(api+'/embeds/send',{method:'POST',body:JSON.stringify({channelId:$('embedChannel').value,content:$('embedContent').value,title:$('embedTitle').value,description:$('embedDescription').value,color:$('embedColor').value,footer:$('embedFooter').value,thumbnail:$('embedThumbnail').value,image:$('embedImage').value})});status('embedStatus','Embed sent successfully.')}catch(e){status('embedStatus',e.message,true)}};
$('saveModules').onclick=async()=>{try{await request(api+'/modules',{method:'PUT',body:JSON.stringify({leveling:{enabled:$('levelEnabled').checked},economy:{enabled:$('economyEnabled').checked},music:{enabled:$('musicEnabled').checked,alwaysOn:$('musicAlwaysOn').checked,defaultVolume:+$('musicVolume').value,queueLimit:+$('musicQueue').value,djRoleId:$('musicDjRole').value}})});status('moduleStatus','Module settings saved.')}catch(e){status('moduleStatus',e.message,true)}};
async function loadCommands(){try{const rows=await request(api+'/commands');$('commandList').innerHTML='';if(!rows.length){$('commandList').textContent='No custom commands yet.';return}rows.forEach(c=>{const el=document.createElement('div');el.className='premium-item';const left=document.createElement('div'),b=document.createElement('b'),small=document.createElement('small');b.textContent='!'+c.name;small.textContent=(c.enabled?'Enabled':'Disabled')+' · '+c.cooldownSeconds+'s cooldown';left.append(b,small);const del=document.createElement('button');del.className='btn danger';del.textContent='Delete';del.onclick=async()=>{if(!confirm('Delete !'+c.name+'?'))return;try{await request(api+'/commands/'+c._id,{method:'DELETE'});loadCommands()}catch(e){status('commandStatus',e.message,true)}};el.append(left,del);$('commandList').append(el)})}catch(e){$('commandList').textContent='Could not load commands: '+e.message}}
$('createCommand').onclick=async()=>{try{await request(api+'/commands',{method:'POST',body:JSON.stringify({name:$('commandName').value,response:$('commandResponse').value,enabled:$('commandEnabled').checked,cooldownSeconds:+$('commandCooldown').value})});$('commandName').value='';$('commandResponse').value='';status('commandStatus','Command created.');loadCommands()}catch(e){status('commandStatus',e.message,true)}};load();setInterval(()=>request(api+'/overview').then(d=>{$('statMembers').textContent=d.members??'—';$('statChannels').textContent=d.channels??'—';$('statPing').textContent=d.bot?.ping==null?'—':d.bot.ping+' ms';$('statCommands').textContent=d.customCommands??0}).catch(()=>{}),15000);
</script></body></html>
