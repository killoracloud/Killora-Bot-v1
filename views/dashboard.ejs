<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard | Killora Bot</title><link rel="stylesheet" href="/style.css"></head><body><nav><b>KILLORA<span>_BOT</span></b><div><%=user.username%> · <a href="/logout">Logout</a></div></nav><main class="wrap"><h1>Bot servers</h1><p>Select a server where the bot is installed.</p><section class="grid"><% guilds.forEach(g=>{ %><a class="card" href="/dashboard/<%=g.id%>"><div class="servericon"><%=g.name.slice(0,1).toUpperCase()%></div><h3><%=g.name%></h3><small>Open configuration →</small></a><% }) %></section><% if(!guilds.length){ %><div class="card">No bot servers are available yet. Make sure the Discord bot is online and has joined a server.</div><% } %></main></body></html>
