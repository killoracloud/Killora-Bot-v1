<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Killora Bot • Advanced</title><link rel="stylesheet" href="/style.css"><style>body{padding:24px}.wrap{max-width:1000px;margin:auto}.card{background:#151a22;border:1px solid #303846;border-radius:14px;padding:20px;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}input,select,textarea,button{width:100%;padding:11px;margin:6px 0;border-radius:8px;border:1px solid #45505f;background:#0d1117;color:#fff}button{background:#39ff14;color:#081006;font-weight:700;cursor:pointer}.muted{color:#aab4c3}.stats{font-size:28px;font-weight:800}</style></head><body><main class="wrap"><a href="/dashboard/<%= guild.id %>">← Back to server dashboard</a><h1>Advanced Control Center</h1><p class="muted">Analytics, automation workflows and premium licensing.</p><section class="card"><h2>Server Analytics</h2><select id="days"><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select><div class="grid" id="stats"></div></section><section class="card"><h2>Create Automation</h2><form id="automation"><input name="name" placeholder="Workflow name" required><select name="trigger"><option value="memberJoin">Member joins</option><option value="memberLeave">Member leaves</option><option value="messageContains">Message contains text</option></select><input name="match" placeholder="Required text (message trigger only)"><div class="grid"><select name="action"><option value="sendMessage">Send message</option><option value="addRole">Add role</option></select><input name="channelId" placeholder="Target channel ID"><input name="roleId" placeholder="Role ID (for Add role)"></div><textarea name="content" placeholder="Message to send (for Send message)"></textarea><button>Create workflow</button></form><div id="workflows"></div></section><section class="card"><h2>Premium License</h2><form id="license"><input name="key" placeholder="Enter license key" required><button>Activate license</button></form><p id="licenseResult" class="muted"></p></section></main><script>
const gid=<%- JSON.stringify(guild.id) %>;const api=`/api/guild/${gid}`;async function loadStats(){const d=document.querySelector('#days').value;const r=await fetch(`${api}/analytics?days=${d}`);const x=await r.json();document.querySelector('#stats').innerHTML=['messages','joins','leaves','tickets'].map(k=>`<div><div class="muted">${k}</div><div class="stats">${x[k]||0}</div></div>`).join('')};async function loadFlows(){const r=await fetch(`${api}/automations`);const a=await r.json();document.querySelector('#workflows').innerHTML=a.map(x=>`<div class="card"><b>${x.name}</b> · ${x.trigger} · ${x.enabled?'Enabled':'Disabled'}<button onclick="toggleFlow('${x._id}',${!x.enabled})">${x.enabled?'Disable':'Enable'}</button><button onclick="deleteFlow('${x._id}')">Delete</button></div>`).join('')||'<p class="muted">No workflows configured.</p>'};async function toggleFlow(id,enabled){await fetch(`${api}/automations/${id}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled})});loadFlows()}async function deleteFlow(id){await fetch(`${api}/automations/${id}`,{method:'DELETE'});loadFlows()}document.querySelector('#automation').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target);const body={name:f.get('name'),trigger:f.get('trigger'),match:f.get('match'),actions:[{type:f.get('action'),channelId:f.get('channelId'),roleId:f.get('roleId'),content:f.get('content')}]};const r=await fetch(`${api}/automations`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const x=await r.json();if(!r.ok)alert(x.error||'Could not save');else{e.target.reset();loadFlows()}};document.querySelector('#license').onsubmit=async e=>{e.preventDefault();const key=new FormData(e.target).get('key');const r=await fetch(`${api}/license/activate`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key})});const x=await r.json();document.querySelector('#licenseResult').textContent=r.ok?`Activated: ${x.plan} · expires ${x.expiresAt||'never'}`:(x.error||'Activation failed')};document.querySelector('#days').onchange=loadStats;loadStats();loadFlows();</script></body></html>
